# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Local MongoDB (Option 1)
MONGODB_URI=mongodb://localhost:27017/cuet-advisor-panel
# MongoDB Atlas Cloud (Option 2) - Replace with your connection string
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cuet-advisor-panel

# Authentication
# REQUIRED: Generate a strong random secret (minimum 32 characters)
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Email Service (Gmail SMTP)
# REQUIRED: Your Gmail email address
GMAIL_USER=advisor@cuet.ac.bd
# REQUIRED: Gmail App Password (NOT your regular Gmail password)
# Get it from: https://myaccount.google.com/apppasswords (requires 2FA enabled)
GMAIL_APP_PASSWORD=your-16-char-app-password-from-google

# AI Service (Google Gemini API)
# REQUIRED: Get your API key from Google AI Studio
# Get it from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-from-google-ai-studio

# AI Service Configuration
# Choose which AI service to use: 'ollama' (local) or 'gemini' (cloud)
# Default: ollama (uses local Ollama server)
AI_SERVICE=ollama

# Ollama Configuration (Local AI Model)
# OPTIONAL: Ollama server URL (defaults to http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# OPTIONAL: Ollama model name (defaults to qwen2.5-7b-flirty:latest)
# Change this to match YOUR installed model name
# Examples:
#   - llama3:latest
#   - mistral:latest
#   - qwen2.5:7b
#   - your-custom-model-name
# Run 'ollama list' in terminal to see your installed models
OLLAMA_MODEL=qwen2.5-7b-flirty:latest

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:4200
